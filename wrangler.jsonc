{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rol-familiar",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "rol-familiar",
    "database_id": "5c1955b5-fbb5-4051-adb3-307a9eea0741",
    "migrations_dir": "migrations"
  }],
  "env": {
    "preview": {
      "d1_databases": [{
        "binding": "DB",
        "database_name": "rol-familiar-preview",
        "database_id": "c66d1cb6-56cd-46a0-825c-e8df5687516d",
        "migrations_dir": "migrations"
      }]
    }
  }
}
